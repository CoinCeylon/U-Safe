      "resolved": "apps/web",
      "link": true
    },
    "packages/chain": {
      "name": "@usafe/chain",
      "version": "0.0.0"
    },
    "packages/crypto": {
      "name": "@usafe/crypto",
      "version": "0.0.0"
    },
    "packages/shared": {
      "name": "@usafe/shared",
      "version": "0.0.0"
    },
    "server": {
