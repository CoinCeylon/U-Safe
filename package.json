{
  "name": "usafe",
  "private": true,
  "version": "0.0.0",
  "description": "U-Safe anonymous ragging complaint system",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server",
    "scripts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bash -c 'if [ -s \"$HOME/.nvm/nvm.sh\" ]; then source \"$HOME/.nvm/nvm.sh\"; nvm use 20 >/dev/null 2>&1 || true; fi; concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w apps/web\"'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bash -c 'if [ -s \"$HOME/.nvm/nvm.sh\" ]; then source \"$HOME/.nvm/nvm.sh\"; nvm use 20 >/dev/null 2>&1 || true; fi; vitest run'",
    "check": "bash -c 'if [ -s \"$HOME/.nvm/nvm.sh\" ]; then source \"$HOME/.nvm/nvm.sh\"; nvm use 20 >/dev/null 2>&1 || true; fi; npm run typecheck && npm run lint && npm run test'",
    "seed": "npm run seed -w server",
    "seed:keys": "tsx scripts/seed-keys.ts",
    "seed:roster": "npm run seed:roster -w server",
    "demo:cli": "tsx scripts/demo-cli.ts",
    "mail:test": "npm run mail:test -w server",
    "try:otp": "npm run try:otp -w server",
    "try:blob": "npm run try:blob -w server",
    "try:event": "npm run try:event -w server",
    "try:forge": "tsx scripts/try-forge.ts",
    "try:duplicate": "tsx scripts/try-duplicate.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.10",
    "nodemailer": "10.6.1"
  }
}
