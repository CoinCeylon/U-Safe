NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CHAIN_MODE=mock
DEMO_MODE=false
# Dev-only: enables the /api/auth/dev-login and /api/auth/dev-accounts routes
# and the red "development login" dropdown in the university portal.
DEV_LOGIN=true
WEB_ORIGIN=http://localhost:5173
# DATABASE_PATH defaults to ./data/usafe.db relative to the server workspace.
# DB_PATH is accepted as an alias for DATABASE_PATH (roadmap section 14).
# Leave both unset for the seeded dev database; an absolute path is required if
# you override it because root-level scripts resolve it from the repo root.
DB_PATH=
BLOB_DIR=
EMAIL_HASH_SALT=dev-email-hash-salt
SESSION_SECRET=change-me-dev-session-secret
COMMUNITY_DELIVERY_SECRET=change-me-dev-delivery-secret

MAIL_MODE=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@usafe.local

MERKLE_TREE_DEPTH=20
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
ENROLLMENT_TICKET_EXPIRY_MINUTES=15
FILING_LIMIT_PER_MONTH=2
MAX_EVIDENCE_FILES=5
MAX_EVIDENCE_FILE_BYTES=26214400
CATEGORIES=verbal,physical,sexual,cyber,financial,other
URGENCIES=normal,urgent
STATUSES=not_started,pending_investigation,finished
NORMAL_DEADLINE_SECONDS=604800
URGENT_DEADLINE_SECONDS=86400
DEMO_SLA_SECONDS=
SUPPORT_ALERT_THRESHOLD=10
MIN_GROUP_SIZE=5
ENROLLMENT_GRACE_DAYS=14
RUN_CHAIN_TESTS=0
HELPLINES=

# Groups 8-10 (reserved; not read until the chain milestones)
CARDANO_NETWORK=preprod
CARDANO_PROVIDER=
BLOCKFROST_KEY=
SPONSOR_MNEMONIC=
MIDNIGHT_NODE_URL=
MIDNIGHT_INDEXER_URL=
MIDNIGHT_INDEXER_WS_URL=
PROOF_SERVER_URL=
MIDNIGHT_SPONSOR_SEED=
MIDNIGHT_CONTRACT_ADDRESS=
